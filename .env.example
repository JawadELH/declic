# Copie ce fichier en .env.local puis renseigne les valeurs de ton projet Firebase
# (Console Firebase → Paramètres du projet → Vos applications → Application Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ton-projet
VITE_FIREBASE_STORAGE_BUCKET=ton-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clé VAPID pour les notifications web push
# (Console Firebase → Paramètres du projet → Cloud Messaging → Certificats Web push → Générer).
VITE_FIREBASE_VAPID_KEY=

# Région des Cloud Functions (doit correspondre à functions/index.js)
VITE_FUNCTIONS_REGION=europe-west1

# Mettre à true pour utiliser les émulateurs locaux (npm run emulators)
VITE_USE_EMULATORS=false
